---
const { href, name, highlight, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'navbar-link box-border block px-1.5 py-0.5 font-medium transition-opacity duration-150 hover:opacity-70',
    highlight === 'true' ? 'bg-accent text-ink' : 'text-paper',
    className,
  ]}
>
  {name}
</a>
