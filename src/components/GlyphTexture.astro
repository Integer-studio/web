---
/**
 * The glyph texture — Figma node `533:28`.
 *
 * In the file this is one enormous text layer of random punctuation sitting
 * above the section backgrounds and below the cards. Here it is generated at
 * build time from a fixed seed, so the output is deterministic and does not
 * flicker between builds, and it is scoped to the light sections only.
 *
 * Distribution is *stratified*, not independent per cell: the grid is cut into
 * square blocks and exactly one glyph is placed at a random spot inside each
 * block. Rolling a coin per cell (the obvious approach) clumps — it leaves
 * visible clusters and bald patches, which read as dirt rather than texture.
 * One-per-block keeps the local density constant everywhere while the jitter
 * keeps it from looking like a lattice.
 *
 * Decorative: aria-hidden, unselectable, never a pointer target.
 */
interface Props {
  class?: string;
  rows?: number;
  cols?: number;
  /** Share of cells that carry a glyph. Sets the block size. */
  density?: number;
  seed?: number;
}

const {
  class: className = '',
  rows = 80,
  cols = 320,
  density = 0.25,
  seed = 0x5eed,
} = Astro.props;

/* The characters actually used in the Figma layer. */
const GLYPHS = '@!\;][|&()><#$?:~/{}%';

/* mulberry32 — small, deterministic, no dependency. */
function rng(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(seed);

/* One glyph per block of `block × block` cells. */
const block = Math.max(1, Math.round(Math.sqrt(1 / density)));

const grid: string[][] = Array.from({ length: rows }, () =>
  new Array(cols).fill(' ')
);

for (let br = 0; br < rows; br += block) {
  for (let bc = 0; bc < cols; bc += block) {
    const r = br + Math.floor(rand() * Math.min(block, rows - br));
    const c = bc + Math.floor(rand() * Math.min(block, cols - bc));
    grid[r][c] = GLYPHS[Math.floor(rand() * GLYPHS.length)];
  }
}

const field = grid.map((row) => row.join('').replace(/\s+$/, '')).join('\n');
---

<div
  aria-hidden="true"
  class:list={[
    'pointer-events-none absolute inset-0 z-0 select-none overflow-hidden',
    className,
  ]}
>
  <pre
    class="absolute top-1/2 left-1/2 m-0 -translate-x-1/2 -translate-y-1/2 font-mono text-[12px] leading-[22px] whitespace-pre text-card-ink opacity-[0.14]">{field}</pre>
</div>
