---
import type { ImageMetadata } from 'astro';
import GlyphTexture from './GlyphTexture.astro';

/**
 * Team card. Figma component `536:70` — 316 × 488.
 *
 * The card has no radius and no border: its shape is defined entirely by five
 * rules, and all five paint *on top of* the portrait, so the two verticals
 * cross the image. Offsets are percentages of the Figma box so the whole
 * card scales as one piece at any column width:
 *
 *   verticals   x=30 and x=282  ->  9.494% from the left, 10.759% from the right
 *   horizontals y=32 and y=456  ->  6.557% from the top and bottom
 *   name band   y=382..456      ->  6.557%..21.721% from the bottom
 *   portrait    252 x 350       ->  spans the verticals, 71.721% tall
 *
 * Without a portrait the slot shows the person's initials over the glyph
 * texture, so a team with only some photos still reads as one set. Portraits
 * should be head-and-shoulders crops close to 252:350; they are always covered,
 * never stretched.
 */
interface Props {
  name: string;
  portrait?: ImageMetadata;
  /** Seed for the placeholder texture, so the three cards are not identical. */
  seed?: number;
}

const { name, portrait, seed = 0x1e7 } = Astro.props;

const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .join('');

const L = '9.494%'; /* 30/316  */
const R = '10.759%'; /* 34/316  */
const T = '6.557%'; /* 32/488  */
const BAND = '21.721%'; /* 106/488 */
---

<article class="person relative aspect-[316/488] w-full bg-ink-raised">
  <div
    class="absolute h-[71.721%] overflow-hidden"
    style={`left:${L};right:${R};top:${T}`}
  >
    {
      portrait ? (
        <img
          src={portrait.src}
          alt={`${name}, portrét`}
          width={portrait.width}
          height={portrait.height}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
        />
      ) : (
        <>
          <GlyphTexture tone="dark" rows={40} cols={60} seed={seed} />
          <span
            aria-hidden="true"
            class="monogram absolute inset-0 flex items-center justify-center font-serif leading-none text-accent"
          >
            {initials}
          </span>
        </>
      )
    }
  </div>

  <!-- Rules. Decorative, and deliberately above the portrait. -->
  <span
    aria-hidden="true"
    class="absolute inset-x-0 h-px bg-rule"
    style={`top:${T}`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 h-px bg-rule"
    style={`bottom:${T}`}></span>
  <span
    aria-hidden="true"
    class="absolute h-px bg-rule"
    style={`left:${L};right:${R};bottom:${BAND}`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 w-px bg-rule"
    style={`left:${L}`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 w-px bg-rule"
    style={`right:${R}`}></span>

  <h3
    class="name absolute flex items-center justify-center font-serif leading-none tracking-[0.02em] text-on-dark"
    style={`left:${L};right:${R};bottom:${T};height:calc(${BAND} - ${T})`}
  >
    {name}
  </h3>
</article>

<style>
  /* Everything inside the card is sized off the card's own width, so the
     name always fits the 252px band — whether the cards sit three across or
     one per row on a phone. */
  .person {
    container-type: inline-size;
  }
  .name {
    font-size: 11cqi;
  }
  .monogram {
    font-size: 34cqi;
    letter-spacing: -0.02em;
  }
</style>
