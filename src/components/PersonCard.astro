---
import type { ImageMetadata } from 'astro';

/**
 * Figma component `536:70` — 316 × 488.
 *
 * The card has no radius and no border: its shape is defined entirely by five
 * accent rules, and all five paint *on top of* the portrait, so the two
 * verticals cross the image. Offsets are expressed as percentages of the
 * Figma box so the whole card scales as one piece at any column width:
 *
 *   verticals   x=30 and x=282  ->  9.494% from the left, 10.759% from the right
 *   horizontals y=32 and y=456  ->  6.557% from the top and bottom
 *   name band   y=382..456      ->  6.557%..21.721% from the bottom
 *   portrait    252 x 350       ->  spans the verticals, 71.721% tall
 */
interface Props {
  name: string;
  portrait: ImageMetadata;
  flashy?: boolean;
  /** Show the whole portrait uncropped instead of the usual object-cover
   *  box. The card's height then follows the image, so it will no longer
   *  line up with the other (fixed 316x488) cards in the row. */
  fullImage?: boolean;
}

const { name, portrait, flashy = false, fullImage = false } = Astro.props;

const L = '9.494%'; /* 30/316  */
const R = '10.759%'; /* 34/316  */
const T = '6.557%'; /* 32/488  */
const BAND = '21.721%'; /* 106/488 */
---

<article
  class={`relative w-full bg-ink-raised ${fullImage ? '' : 'aspect-[316/488]'} ${flashy ? 'card-flashy' : ''}`}
>
  {
    fullImage ? (
      <div class="w-full" style={`padding-left:${L};padding-right:${R};padding-top:${T}`}>
        <img
          src={portrait.src}
          alt={name}
          width={portrait.width}
          height={portrait.height}
          class="w-full h-auto object-contain"
        />
      </div>
    ) : (
      <div class="absolute h-[71.721%] overflow-hidden" style={`left:${L};right:${R};top:${T}`}>
        <img
          src={portrait.src}
          alt={name}
          width={portrait.width}
          height={portrait.height}
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <!-- Rules. Decorative, and deliberately above the portrait. -->
  <span
    aria-hidden="true"
    class="absolute inset-x-0 h-px bg-rule"
    style={`top:${T}`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 h-px bg-rule"
    style={`bottom:${T}`}></span>
  <span
    aria-hidden="true"
    class="absolute h-px bg-rule"
    style={`left:${L};right:${R};bottom:${BAND}`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 w-px bg-rule"
    style={`left:${L}`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 w-px bg-rule"
    style={`right:${R}`}></span>

  <h3
    class={`absolute flex items-center justify-center font-serif text-[clamp(1.5rem,3.5vw,3rem)] leading-none tracking-[0.02em] text-on-dark ${flashy ? 'name-flashy' : ''}`}
    style={`left:${L};right:${R};bottom:${T};height:calc(${BAND} - ${T})`}
  >
    {
      flashy ? (
        <span class="name-flashy-inner">
          <span class="name-default">{name}</span>
          <span class="name-hover" aria-hidden="true">
            Maestro kár
          </span>
        </span>
      ) : (
        <span>{name}</span>
      )
    }
  </h3>
</article>

<style>
  /* Only ever applied when a card is passed `flashy` — an over-the-top joke
     hover for one specific name, left inert (unused CSS) for everyone else.
     The trigger sits on the whole card (`.card-flashy`), not just the name,
     so hovering the portrait fires it too. */
  .name-flashy {
    overflow: visible;
  }

  .name-flashy-inner {
    position: relative;
    display: inline-block;
    transform-origin: 50% 50%;
  }

  .name-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  .card-flashy:hover .name-default {
    opacity: 0;
  }

  .card-flashy:hover .name-hover {
    opacity: 1;
    animation: name-flashy-spin 0.6s ease-in-out infinite;
  }

  @keyframes name-flashy-spin {
    0% {
      transform: scale(1) rotate(0deg);
      color: #ff2d75;
      text-shadow:
        0 0 6px #ff2d75,
        0 0 18px #ff2d75;
    }
    20% {
      transform: scale(1.6) rotate(-8deg);
      color: #ffe62d;
      text-shadow:
        0 0 6px #ffe62d,
        0 0 22px #ffe62d;
    }
    40% {
      transform: scale(1.9) rotate(8deg);
      color: #2dff88;
      text-shadow:
        0 0 6px #2dff88,
        0 0 26px #2dff88;
    }
    60% {
      transform: scale(1.7) rotate(-10deg);
      color: #2dd4ff;
      text-shadow:
        0 0 6px #2dd4ff,
        0 0 24px #2dd4ff;
    }
    80% {
      transform: scale(2) rotate(6deg);
      color: #c02dff;
      text-shadow:
        0 0 6px #c02dff,
        0 0 28px #c02dff;
    }
    100% {
      transform: scale(1) rotate(0deg);
      color: #ff2d75;
      text-shadow:
        0 0 6px #ff2d75,
        0 0 18px #ff2d75;
    }
  }
</style>
