---
/** The wordmark. On a one-pager the hover sends you back to the top. */
---

<p
  class="logo-container m-0 inline-flex items-baseline text-3xl tracking-tighter text-accent"
>
  &#123;<span
    class="intlogo-wrapper inline-block overflow-hidden px-0.5 text-paper hover:italic"
    ><span class="intlogo inline-block">integer</span></span
  >&#125;
</p>

<script>
  // Only load GSAP and run animations on desktop devices (768px and above)
  const isDesktop = window.matchMedia('(min-width: 768px)').matches;

  if (isDesktop) {
    Promise.all([import('gsap'), import('gsap/TextPlugin')]).then(
      ([{ gsap }, { TextPlugin }]) => {
        gsap.registerPlugin(TextPlugin);

        const container = document.querySelector('.logo-container');
        const text = document.querySelector('.intlogo');

        const swap = (value: string) => {
          gsap
            .timeline()
            .to(text, { duration: 0.2, x: -20, opacity: 0, ease: 'power2.in' })
            .set(text, { text: { value }, x: 20 })
            .to(text, { duration: 0.2, x: 0, opacity: 1, ease: 'power2.out' });
        };

        container?.addEventListener('mouseenter', () => swap('&#8593;nahoru'));
        container?.addEventListener('mouseleave', () => swap('integer'));
      }
    );
  }
</script>
